[Unit]
Description=Apollo OS Notification Handler
Documentation=man:apollo-os-notification-handler(1)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/apollo-os-notification-handler.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/apollo-os

[Install]
WantedBy=default.target
