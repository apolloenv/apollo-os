[Unit]
Description=Apollo OS Right Ctrl Voice Input Trigger
After=graphical-session.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/apollo-os-rightctrl-voice.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Import environment from graphical session for wtype/notify-send
Environment=XDG_RUNTIME_DIR=/run/user/%U
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE

[Install]
WantedBy=default.target
