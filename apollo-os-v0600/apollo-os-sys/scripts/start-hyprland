#!/bin/bash

#####################################################################
# Apollo OS - Hyprland Wrapper Script v0.6.0
# Copyright © 2025 by Manuel Kraibacher
#
# Description: Launches Hyprland with Apollo OS Glass configuration
# Services (Quickshell, hypridle, etc.) are started by execs.conf
#####################################################################

set -eo pipefail

# Configuration
APOLLO_CONFIG="$HOME/.config/apollo-os/config.env"
HYPR_CONFIG="$HOME/.config/hypr/hyprland.conf"

# Load Apollo OS configuration if exists
if [[ -f "$APOLLO_CONFIG" ]]; then
    source "$APOLLO_CONFIG"
fi

# Check if Hyprland config exists
if [[ ! -f "$HYPR_CONFIG" ]]; then
    echo "ERROR: Hyprland configuration not found!"
    echo "Expected: $HYPR_CONFIG"
    echo ""
    echo "Returning to login in 5 seconds..."
    sleep 5
    exit 0
fi

# Verify Hyprland is installed
if ! command -v Hyprland &>/dev/null; then
    echo "ERROR: Hyprland compositor not found!"
    echo "Install with: sudo dnf install hyprland"
    echo ""
    echo "Returning to login in 5 seconds..."
    sleep 5
    exit 0
fi

# Export environment variables for the session
export APOLLO_WM="Hyprland"
export APOLLO_THEME="dark"
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

# Log session start
echo "[Apollo OS] Starting Hyprland session"
echo "  Config: $HYPR_CONFIG"

# Launch Hyprland
exec Hyprland
