// =============================================================================
// NIRI WM KONFIGURATION - SGI IRIX STYLE
// =============================================================================
// Silicon Graphics IRIX Indigo Magic Design
// Klassische Unix Workstation Ästhetik
// =============================================================================

input {
    focus-follows-mouse max-scroll-amount="100%"

    keyboard {
        xkb {
            layout "de"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.1
        accel-profile "adaptive"
        scroll-factor 1.0
    }
}

output "eDP-1" {
    scale 1.0
    position x=0 y=0
}

output "DP-2" {
    scale 1.0
    position x=1536 y=0
}

overview {
    zoom 0.5
    backdrop-color "#1a1a30"
    workspace-shadow {
        off
    }
}

hotkey-overlay {
    skip-at-startup true
}

// -----------------------------------------------------------------------------
// LAYOUT - SGI IRIX STYLE
// -----------------------------------------------------------------------------
layout {
    gaps 12
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.85
        proportion 1.0
    }

    // SGI Teal Border
    border {
        width 3
        active-color "#00a8a8"
        inactive-color "#3a3a5a"
    }

    shadow {
        on
        softness 12
        spread 1
        offset x=0 y=3
        color "#00000066"
    }

    focus-ring {
        width 0
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

// -----------------------------------------------------------------------------
// FENSTER-REGELN
// -----------------------------------------------------------------------------
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match is-focused=false
    opacity 0.96
}

window-rule {
    match is-focused=true
    opacity 1.0
}

window-rule {
    match app-id=r"^(com.microsoft.Edge|code|org.gnome.Loupe|org.gnome.eog|org.gnome.Totem|io.github.celluloid_player.Celluloid|org.remmina.Remmina|remmina)$"
    default-column-width { proportion 1.0; }
}

window-rule {
    match is-floating=true
    default-column-width { proportion 0.6; }
}

// -----------------------------------------------------------------------------
// STARTUP
// -----------------------------------------------------------------------------
spawn-at-startup "xwayland-satellite"
spawn-at-startup "sh" "-c" "swaybg -i $HOME/System/Wallpaper/current.jpg -m fill"
spawn-at-startup "sh" "-c" "sleep 1 && waybar -c $HOME/.config/waybar/config-niri -s $HOME/.config/waybar/style.css"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"
spawn-at-startup "sh" "-c" "swayidle -w before-sleep 'hyprlock'"
spawn-at-startup "sh" "-c" "sleep 4 && notify-send 'APOLLO OS' 'System initialized. All services operational.'"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/apollo-os-power-monitor.sh"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/apollo-os-network-monitor.sh"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/apollo-os-sleep-monitor.sh"
spawn-at-startup "sh" "-c" "$HOME/.config/niri/apollo-autostart.sh"

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// -----------------------------------------------------------------------------
// TASTENKÜRZEL
// -----------------------------------------------------------------------------
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Space { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-rofi-launcher.sh"; }
    Mod+Shift+Space { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-quickmenu.sh"; }
    Mod+Ctrl+Space { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-wallpaper-cycle.sh"; }

    Mod+Q { close-window; }
    Mod+W { toggle-window-floating; }
    Mod+E { consume-or-expel-window-right; }
    Mod+O { toggle-overview; }
    Mod+M { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+C { spawn "sh" "-c" "$HOME/.config/niri/toggle-center.sh"; }
    Mod+J { spawn "sh" "-c" "$HOME/.config/niri/toggle-waybar.sh"; }
    Mod+G { spawn "sh" "-c" "$HOME/.config/niri/toggle-gaps.sh"; }
    Mod+R { switch-preset-column-width; }

    Mod+D { spawn "nautilus" "--new-window"; }
    Mod+N { spawn "gnome-text-editor" "--new-window"; }
    Mod+Return { spawn "alacritty"; }
    Mod+K { spawn "kitty"; }
    Mod+B { spawn "firefox" "--new-window"; }
    Mod+T { spawn "ptyxis" "--new-window"; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }

    Mod+Alt+Left  { move-column-left; }
    Mod+Alt+Right { move-column-right; }
    Mod+Alt+Up    { move-window-up; }
    Mod+Alt+Down  { move-window-down; }

    Mod+Ctrl+Left  { set-column-width "-10%"; }
    Mod+Ctrl+Right { set-column-width "+10%"; }
    Mod+Ctrl+Up    { set-window-height "-10%"; }
    Mod+Ctrl+Down  { set-window-height "+10%"; }

    Ctrl+Mod+L { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-lock.sh"; }
    Mod+L { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-lock-hypr.sh"; }
    Mod+Shift+E { quit; }
    Mod+Shift+R { spawn "sh" "-c" "pkill waybar; sleep 0.5; waybar -c $HOME/.config/waybar/config-niri & disown"; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+S { spawn "sh" "-c" "grim -g \"$(slurp)\" ~/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send 'Screenshot' 'Saved to Screenshots'"; }
    
    // ─── Voice Input ───────────────────────────────────────────────────────
    Mod+V { spawn "sh" "-c" "$HOME/.local/bin/voice-input"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    Mod+Tab { focus-window-down-or-column-right; }
    Mod+Shift+Tab { focus-window-up-or-column-left; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
}

// -----------------------------------------------------------------------------
// ANIMATIONEN - SGI Smooth
// -----------------------------------------------------------------------------
animations {
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    config-notification-open-close {
        duration-ms 200
        curve "ease-out-quad"
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
}

screenshot-path "~/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

prefer-no-csd

environment {
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gnome"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    GDK_BACKEND "wayland"
    CLUTTER_BACKEND "wayland"
    SDL_VIDEODRIVER "wayland"
    MOZ_ENABLE_WAYLAND "1"
    GTK_THEME "adw-gtk3-dark"
    ADW_DEBUG_COLOR_SCHEME "prefer-dark"
}
