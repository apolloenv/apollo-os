[
    {
        "layer": "top",
        "position": "bottom",
        "height": 36,
        "margin-bottom": 8,
        "margin-left": 8,
        "margin-right": 8,
        "spacing": 0,

        "modules-left": [
            "custom/logo",
            "niri/workspaces",
            "custom/separator",
            "niri/window"
        ],
        "modules-center": [
            "custom/media"
        ],
        "modules-right": [
            "tray",
            "custom/separator",
            "cpu",
            "memory",
            "disk",
            "temperature",
            "custom/separator",
            "network",
            "pulseaudio",
            "backlight",
            "custom/separator",
            "battery",
            "clock"
        ],

        "custom/logo": {
            "format": "󱓞",
            "tooltip": true,
            "tooltip-format": "Apollo OS Nova",
            "on-click": "~/.local/bin/apollo-os-rofi-launcher.sh"
        },

        "custom/separator": {
            "format": "│",
            "tooltip": false
        },

        "niri/workspaces": {
            "format": "{icon}",
            "format-icons": {
                "active": "󰮯",
                "default": "󰊠"
            }
        },

        "niri/window": {
            "format": "{}",
            "max-length": 40,
            "tooltip": false
        },

        "custom/media": {
            "format": "󰎈 {}",
            "max-length": 50,
            "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null || echo ''",
            "interval": 2,
            "on-click": "playerctl play-pause",
            "on-scroll-up": "playerctl next",
            "on-scroll-down": "playerctl previous"
        },

        "cpu": {
            "format": "󰻠 {usage}%",
            "format-alt": "󰻠 {avg_frequency}GHz",
            "tooltip-format": "CPU: {usage}%\nFrequenz: {avg_frequency} GHz",
            "interval": 2,
            "on-click": "alacritty -e btop"
        },

        "memory": {
            "format": "󰍛 {percentage}%",
            "format-alt": "󰍛 {used:0.1f}G",
            "tooltip-format": "RAM: {used:0.2f}GB / {total:0.2f}GB ({percentage}%)\nSwap: {swapUsed:0.2f}GB / {swapTotal:0.2f}GB",
            "interval": 5
        },

        "disk": {
            "format": "󰋊 {percentage_used}%",
            "format-alt": "󰋊 {used}/{total}",
            "path": "/",
            "tooltip-format": "Disk: {used} / {total} ({percentage_used}%)\nFrei: {free}",
            "interval": 30
        },

        "temperature": {
            "format": "󰔏 {temperatureC}°C",
            "tooltip-format": "Temperatur: {temperatureC}°C",
            "critical-threshold": 80,
            "interval": 5
        },

        "network": {
            "format-wifi": "󰖩 {essid}",
            "format-ethernet": "󰈀 {ipaddr}",
            "format-disconnected": "󰤮 Offline",
            "tooltip-format-wifi": "WLAN: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nDown: {bandwidthDownBits} Up: {bandwidthUpBits}",
            "tooltip-format-ethernet": "Ethernet: {ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBits} Up: {bandwidthUpBits}",
            "interval": 5,
            "on-click": "~/.local/bin/apollo-os-wifi.sh"
        },

        "bluetooth": {
            "format": "󰂯",
            "format-connected": "󰂱 {num_connections}",
            "format-disabled": "󰂲",
            "tooltip-format": "{controller_alias}\n{num_connections} verbunden",
            "on-click": "~/.local/bin/apollo-os-bluetooth.sh"
        },

        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": "󰝟 Mute",
            "format-icons": {
                "default": ["󰕿", "󰖀", "󰕾"]
            },
            "tooltip-format": "Lautstärke: {volume}%\nGerät: {desc}",
            "on-click": "pavucontrol",
            "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
            "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
        },

        "backlight": {
            "format": "{icon} {percent}%",
            "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
            "tooltip-format": "Helligkeit: {percent}%",
            "on-scroll-up": "brightnessctl set 2%+",
            "on-scroll-down": "brightnessctl set 2%-"
        },

        "battery": {
            "format": "{icon} {capacity}%",
            "format-charging": "󰂄 {capacity}%",
            "format-plugged": "󱐥 {capacity}%",
            "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "tooltip-format": "Batterie: {capacity}%\n{timeTo}\nLeistung: {power}W",
            "states": {
                "warning": 30,
                "critical": 15
            },
            "on-click": "~/.local/bin/apollo-os-power-profile.sh"
        },

        "clock": {
            "format": "󰥔 {:%H:%M}",
            "format-alt": "󰃭 {:%a, %d. %b %Y  󰥔 %H:%M:%S}",
            "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
            "interval": 1
        },

        "tray": {
            "icon-size": 16,
            "spacing": 8
        }
    }
]
