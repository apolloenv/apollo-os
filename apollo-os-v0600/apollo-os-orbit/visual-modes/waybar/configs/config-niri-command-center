[
    {
        "layer": "top",
        "position": "top",
        "height": 32,
        "spacing": 0,

        "modules-left": [
            "custom/logo",
            "niri/workspaces",
            "custom/sep",
            "cpu",
            "memory",
            "disk",
            "temperature"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "network#speed",
            "custom/sep",
            "custom/localip",
            "network",
            "custom/sep",
            "backlight",
            "pulseaudio",
            "custom/sep",
            "battery",
            "custom/power-profile",
            "tray"
        ],

        "custom/logo": {
            "format": "󰍉",
            "tooltip-format": "Apollo OS Enterprise",
            "on-click": "~/.local/bin/apollo-os-rofi-launcher.sh"
        },

        "custom/sep": {
            "format": "│",
            "tooltip": false
        },

        "niri/workspaces": {
            "format": "{index}"
        },

        "cpu": {
            "format": "CPU {usage}%",
            "format-alt": "CPU {avg_frequency}GHz",
            "tooltip-format": "CPU Usage: {usage}%\nFrequency: {avg_frequency} GHz\nLoad: {load}",
            "interval": 2,
            "states": {
                "warning": 70,
                "critical": 90
            }
        },

        "memory": {
            "format": "RAM {percentage}%",
            "format-alt": "RAM {used:0.1f}G/{total:0.1f}G",
            "tooltip-format": "RAM: {used:0.2f}GB / {total:0.2f}GB ({percentage}%)\nSwap: {swapUsed:0.2f}GB / {swapTotal:0.2f}GB",
            "interval": 5,
            "states": {
                "warning": 70,
                "critical": 90
            }
        },

        "disk": {
            "format": "DISK {percentage_used}%",
            "format-alt": "DISK {used}/{total}",
            "path": "/",
            "tooltip-format": "Used: {used} / {total} ({percentage_used}%)\nFree: {free}",
            "interval": 30,
            "states": {
                "warning": 80,
                "critical": 95
            }
        },

        "temperature": {
            "format": "{temperatureC}°C",
            "tooltip-format": "Temperature: {temperatureC}°C",
            "critical-threshold": 80,
            "interval": 5
        },

        "clock": {
            "format": "{:%H:%M:%S}",
            "format-alt": "{:%A, %d. %B %Y  %H:%M:%S}",
            "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
            "locale": "de_DE.UTF-8",
            "interval": 1
        },

        "network#speed": {
            "format": "↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
            "format-disconnected": "OFFLINE",
            "tooltip-format": "Download: {bandwidthDownBits}\nUpload: {bandwidthUpBits}\nInterface: {ifname}",
            "interval": 2
        },

        "custom/localip": {
            "format": "{}",
            "exec": "ip -4 addr show $(ip route | grep default | awk '{print $5}' | head -n1) 2>/dev/null | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}' | head -n1 || echo 'N/A'",
            "interval": 30,
            "tooltip-format": "Local IP Address"
        },

        "network": {
            "format-wifi": "{essid} {signalStrength}%",
            "format-ethernet": "ETH",
            "format-disconnected": "DISCONNECTED",
            "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nFreq: {frequency}MHz",
            "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
            "interval": 5,
            "on-click": "~/.local/bin/apollo-os-wifi.sh"
        },

        "bluetooth": {
            "format": "BT",
            "format-connected": "BT:{num_connections}",
            "format-disabled": "BT:OFF",
            "tooltip-format": "{controller_alias}\n{num_connections} devices connected",
            "on-click": "~/.local/bin/apollo-os-bluetooth.sh"
        },

        "backlight": {
            "format": "BRI {percent}%",
            "tooltip-format": "Brightness: {percent}%",
            "on-scroll-up": "brightnessctl set 2%+",
            "on-scroll-down": "brightnessctl set 2%-"
        },

        "pulseaudio": {
            "format": "VOL {volume}%",
            "format-muted": "MUTE",
            "tooltip-format": "Volume: {volume}%\nDevice: {desc}",
            "on-click": "pavucontrol",
            "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
            "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
        },

        "battery": {
            "format": "BAT {capacity}%",
            "format-charging": "CHG {capacity}%",
            "format-plugged": "AC {capacity}%",
            "tooltip-format": "Battery: {capacity}%\n{timeTo}\nPower: {power}W",
            "states": {
                "warning": 30,
                "critical": 15
            },
            "on-click": "~/.local/bin/apollo-os-power-profile.sh"
        },

        "custom/power-profile": {
            "format": "[{}]",
            "exec": "powerprofilesctl get 2>/dev/null | sed 's/power-saver/PWR/;s/balanced/BAL/;s/performance/PRF/' || echo 'N/A'",
            "interval": 5,
            "tooltip-format": "Power Profile",
            "on-click": "~/.local/bin/apollo-os-power-profile.sh"
        },

        "tray": {
            "icon-size": 12,
            "spacing": 10
        }
    }
]
