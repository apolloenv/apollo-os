[
    {
        "layer": "top",
        "position": "top",
        "height": 32,
        "margin-top": 8,
        "margin-left": 12,
        "margin-right": 12,
        "spacing": 0,

        "modules-left": ["custom/apple", "custom/active-app"],
        "modules-center": [],
        "modules-right": [
            "group/drawer",
            "group/stats-drawer",
            "group/network-drawer",
            "bluetooth",
            "pulseaudio",
            "backlight",
            "battery",
            "custom/power-profile",
            "niri/workspaces",
            "clock",
            "custom/system"],

        "custom/apple": {
            "format": "",
            "tooltip": true,
            "tooltip-format": "Apollo OS - macOS Edition",
            "on-click": "~/.local/bin/apollo-os-rofi-launcher.sh"
        },

        "custom/active-app": {
            "format": "{}",
            "exec": "niri msg focused-window 2>/dev/null | grep -oP '(?<=title: \").*(?=\")' | cut -c1-40 || echo ''",
            "interval": 2,
            "tooltip": false
        },

        "niri/workspaces": {
            "format": "{index}",
            "format-icons": {
                "active": "",
                "default": ""
            }
        },

        "group/drawer": {
            "orientation": "horizontal",
            "drawer": {
                "transition-duration": 400,
                "transition-left-to-right": false
            },
            "modules": ["custom/synology", "custom/btop", "tray"]
        },

        "group/stats-drawer": {
            "orientation": "horizontal",
            "drawer": {
                "transition-duration": 400,
                "transition-left-to-right": false
            },
            "modules": [
                "custom/hostname",
                "cpu",
                "memory",
                "disk",
                "temperature"
            ]
        },

        "group/network-drawer": {
            "orientation": "horizontal",
            "drawer": {
                "transition-duration": 400,
                "transition-left-to-right": false
            },
            "modules": [
                "network",
                "custom/lanip",
                "custom/wanip",
                "network#speed"
            ]
        },

        "network": {
            "format-wifi": "󰖩",
            "format-ethernet": "󰈀",
            "format-disconnected": "󰖪",
            "tooltip-format": "{essid} ({signalStrength}%)\n{ipaddr}",
            "interval": 5,
            "on-click": "~/.local/bin/apollo-os-wifi.sh"
        },

        "custom/lanip": {
            "format": "LAN  {}",
            "exec": "ip -4 addr show $(ip route | grep default | awk '{print $5}' | head -n1) 2>/dev/null | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}' | head -n1 || echo 'N/A'",
            "interval": 10,
            "tooltip-format": "Local IP"
        },

        "custom/wanip": {
            "format": "WAN  {}",
            "exec": "curl -s --max-time 3 ifconfig.me 2>/dev/null || echo 'N/A'",
            "interval": 300,
            "tooltip-format": "Public IP"
        },

        "network#speed": {
            "format": "↓ {bandwidthDownBits}   ↑ {bandwidthUpBits}",
            "format-disconnected": "",
            "tooltip-format": "Download: {bandwidthDownBits}\nUpload: {bandwidthUpBits}",
            "interval": 2
        },

        "custom/hostname": {
            "format": "󰍛",
            "tooltip": true,
            "tooltip-format": "System Monitor"
        },

        "cpu": {
            "format": "{usage}%",
            "format-alt": "{avg_frequency} GHz",
            "tooltip-format": "CPU: {usage}%\nFrequenz: {avg_frequency} GHz",
            "interval": 2,
            "on-click": "alacritty -e btop"
        },

        "memory": {
            "format": "{percentage}%",
            "format-alt": "{used:0.1f}G",
            "tooltip-format": "RAM: {used:0.2f}GB / {total:0.2f}GB ({percentage}%)",
            "interval": 5,
            "on-click": "alacritty -e btop"
        },

        "disk": {
            "format": "{percentage_used}%",
            "format-alt": "{used}/{total}",
            "path": "/",
            "tooltip-format": "Disk: {used} / {total} ({percentage_used}%)",
            "interval": 30
        },

        "temperature": {
            "format": "{temperatureC}°C",
            "tooltip-format": "Temperature: {temperatureC}°C",
            "critical-threshold": 80,
            "interval": 5
        },

        "custom/synology": {
            "format": "",
            "tooltip": true,
            "tooltip-format": "Synology Drive",
            "on-click": "synology-drive"
        },

        "custom/btop": {
            "format": "󰍛",
            "tooltip": "Activity Monitor",
            "on-click": "alacritty -e btop"
        },

        "tray": {
            "icon-size": 16,
            "spacing": 8
        },

        "clock": {
            "format": "{:%H:%M:%S}",
            "format-alt": "{:%A, %d. %B %Y  %H:%M:%S}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
            "interval": 1
        },

        "battery": {
            "format": "{icon}  {capacity}%",
            "format-discharging": "{icon}  {capacity}%",
            "format-charging": "󰂄  {capacity}%",
            "format-plugged": "󱐥  {capacity}%",
            "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "tooltip-format": "Battery: {capacity}% - {power}W",
            "states": { "warning": 30, "critical": 10 },
            "on-click": "~/.local/bin/apollo-os-power-profile.sh"
        },

        "bluetooth": {
            "format": "󰂯",
            "format-connected": "󰂱  {num_connections}",
            "format-disabled": "󰂲",
            "tooltip-format": "{controller_alias}\n{num_connections} connected",
            "on-click": "~/.local/bin/apollo-os-bluetooth.sh"
        },

        "pulseaudio": {
            "format": "{icon}  {volume}%",
            "format-muted": "󰝟  Muted",
            "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
            "tooltip-format": "Volume: {volume}%",
            "on-click": "pavucontrol"
        },

        "backlight": {
            "format": "󰃟  {percent}%",
            "tooltip-format": "Brightness: {percent}%"
        },

        "custom/power-profile": {
            "format": "{}",
            "exec": "powerprofilesctl get 2>/dev/null | sed 's/power-saver/󰌪   Saver/;s/balanced/󰾅   Balanced/;s/performance/󰓅   Performance/' || echo '󰂄'",
            "interval": 5,
            "tooltip": true,
            "tooltip-format": "Power Profile",
            "on-click": "~/.local/bin/apollo-os-power-profile.sh"
        },

        "custom/system": {
            "format": "System",
            "tooltip": true,
            "tooltip-format": "System Settings",
            "on-click": "~/.local/bin/apollo-os-quickmenu.sh"
        }
    }
]
