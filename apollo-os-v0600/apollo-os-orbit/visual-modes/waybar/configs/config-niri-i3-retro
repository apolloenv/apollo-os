[
    {
        "layer": "top",
        "position": "top",
        "height": 32,
        "spacing": 4,

        "modules-left": [
            "niri/workspaces",
            "niri/window"
        ],
        "modules-center": [],
        "modules-right": [
            "cpu",
            "memory",
            "disk",
            "temperature",
            "network",
            "pulseaudio",
            "backlight",
            "battery",
            "clock",
            "tray"
        ],

        "niri/workspaces": {
            "format": "{index}",
            "on-click": "activate"
        },

        "niri/window": {
            "format": "{}",
            "max-length": 60,
            "icon": false,
            "rewrite": {
                "(.*) — Mozilla Firefox": "🌍 $1",
                "(.*) - Visual Studio Code": " $1",
                "(.*)Alacritty": " $1",
                "(.*)Ptyxis": " $1"
            }
        },

        "cpu": {
            "format": "CPU  {usage}%",
            "interval": 2,
            "tooltip-format": "CPU: {usage}%\nFreq: {avg_frequency} GHz",
            "states": {
                "warning": 70,
                "critical": 90
            }
        },

        "memory": {
            "format": "RAM  {percentage}%",
            "interval": 5,
            "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)",
            "states": {
                "warning": 70,
                "critical": 90
            }
        },

        "disk": {
            "format": "DISK  {percentage_used}%",
            "path": "/",
            "interval": 30,
            "tooltip-format": "Disk: {used} / {total} ({percentage_used}%)\nFree: {free}",
            "states": {
                "warning": 80,
                "critical": 95
            }
        },

        "temperature": {
            "format": "TEMP  {temperatureC}°",
            "critical-threshold": 80,
            "interval": 5,
            "tooltip-format": "Temperature: {temperatureC}°C"
        },

        "network": {
            "format-wifi": "NET  {essid}",
            "format-ethernet": "NET  {ipaddr}",
            "format-disconnected": "NET  Offline",
            "interval": 5,
            "tooltip-format-wifi": "WiFi: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
            "tooltip-format-ethernet": "Ethernet\nIP: {ipaddr}\nSpeed: {bandwidthDownBits}",
            "tooltip-format-disconnected": "Network Disconnected",
            "on-click": "nm-connection-editor"
        },

        "pulseaudio": {
            "format": "VOL {icon} {volume}%",
            "format-muted": "VOL  MUTE",
            "format-icons": {
                "default": ["", "", ""]
            },
            "tooltip-format": "Volume: {volume}%\nDevice: {desc}",
            "on-click": "pavucontrol"
        },

        "backlight": {
            "format": "BRI  {percent}%",
            "tooltip-format": "Brightness: {percent}%"
        },

        "battery": {
            "format": "BAT {icon} {capacity}%",
            "format-charging": "BAT  {capacity}%",
            "format-plugged": "BAT  {capacity}%",
            "format-icons": ["", "", "", "", ""],
            "tooltip-format": "{capacity}% • {timeTo}",
            "states": {
                "warning": 30,
                "critical": 15
            }
        },

        "clock": {
            "format": " {:%H:%M}",
            "format-alt": " {:%a %d.%m.%Y • %H:%M:%S}",
            "locale": "de_DE.UTF-8",
            "tooltip-format": "<tt><big>{calendar}</big></tt>",
            "calendar": {
                "mode": "month",
                "on-scroll": 1,
                "format": {
                    "months": "<span color='#e8d5b7'><b>{}</b></span>",
                    "days": "<span color='#e8d5b7'>{}</span>",
                    "weekdays": "<span color='#4a8c8c'><b>{}</b></span>",
                    "today": "<span color='#5d9e7a'><b><u>{}</u></b></span>"
                }
            },
            "interval": 1
        },

        "tray": {
            "icon-size": 16,
            "spacing": 8
        }
    }
]
