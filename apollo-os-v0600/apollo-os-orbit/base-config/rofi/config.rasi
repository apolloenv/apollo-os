configuration {
    show-icons: false;
    display-drun: "Applications";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
    disable-history: false;
    sidebar-mode: false;
}

* {
    /* ═══════════════════════════════════════════════════════════════════════
       DARK GRAYSCALE STYLE
       Minimalist monochrome aesthetic
       ═══════════════════════════════════════════════════════════════════════ */

    /* Grayscale palette */
    background:       #1a1a1a;
    background-alt:   #242424;
    background-hover: #2e2e2e;
    foreground:       #d0d0d0;
    foreground-alt:   #808080;

    /* Selection highlight */
    selected:         #404040;
    selected-alt:     #383838;
    active:           #a0a0a0;
    urgent:           #a05050;
    accent:           #909090;

    /* Border colors */
    border-colour:    #3a3a3a;
    border-light:     #4a4a4a;
    border-dark:      #101010;

    spacing: 0px;
}

window {
    transparency:     "false";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            700px;
    border:           3px solid;
    border-color:     @border-light;
    border-radius:    0px;
    background-color: @background;
}

mainbox {
    enabled:          true;
    spacing:          0px;
    margin:           0px;
    padding:          0px;
    background-color: @background;
    children:         [ "inputbar", "message", "listview" ];
}

/* ─── Titelleiste im IRIX-Stil ─────────────────────────────────────────────── */
inputbar {
    enabled:          true;
    spacing:          12px;
    margin:           0px;
    padding:          14px 16px;
    border:           0px 0px 2px 0px solid;
    border-color:     @border-dark;
    border-radius:    0px;
    background-color: #282828;
    text-color:       @foreground;
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:          true;
    expand:           false;
    str:              ">";
    background-color: transparent;
    text-color:       @accent;
    padding:          0px 8px 0px 0px;
    font:             "JetBrainsMono Nerd Font Bold 13";
}

entry {
    enabled:          true;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           text;
    placeholder:      "Enter command...";
    placeholder-color: @foreground-alt;
}

/* ─── Listendarstellung ────────────────────────────────────────────────────── */
listview {
    enabled:          true;
    columns:          1;
    lines:            6;
    cycle:            true;
    dynamic:          true;
    scrollbar:        true;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          0px;
    margin:           0px;
    padding:          4px;
    background-color: @background;
}

scrollbar {
    width:            12px;
    border:           1px solid;
    border-color:     @border-dark;
    handle-width:     10px;
    handle-color:     #505050;
    background-color: @background-alt;
    padding:          0px;
    margin:           0px;
    border-radius:    0px;
}

/* ─── Listeneinträge ───────────────────────────────────────────────────────── */
element {
    enabled:          true;
    spacing:          12px;
    margin:           1px 2px;
    padding:          10px 14px;
    border:           1px solid;
    border-color:     transparent;
    border-radius:    0px;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @foreground;
    border-color:     transparent;
}

element alternate.normal {
    background-color: @background-alt;
    text-color:       @foreground;
    border-color:     @border-dark;
}

element selected.normal {
    background-color: @selected;
    text-color:       #ffffff;
    border-color:     @accent;
    border:           2px solid;
}

element normal.active {
    background-color: transparent;
    text-color:       @active;
}

element selected.active {
    background-color: @selected-alt;
    text-color:       #ffffff;
    border-color:     @active;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       #ffffff;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             32px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/* ─── Nachrichten ──────────────────────────────────────────────────────────── */
message {
    enabled:          true;
    margin:           0px;
    padding:          10px 14px;
    border:           0px 0px 1px 0px solid;
    border-color:     @border-dark;
    border-radius:    0px;
    background-color: @background-alt;
    text-color:       @foreground;
}

textbox {
    background-color: transparent;
    text-color:       @foreground;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:          12px;
    background-color: #2a1a1a;
    text-color:       @urgent;
    border:           2px solid;
    border-color:     @urgent;
    border-radius:    0px;
}
