[Unit]
Description=Apollo OS Wake TTS Notification
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# Dynamic user detection - uses the first logged-in user on the graphical session
ExecStartPre=/bin/sleep 2
ExecStart=/bin/bash -c 'ACTIVE_USER=$(loginctl list-users --no-legend | head -1 | awk "{print \\$2}"); ACTIVE_UID=$(id -u "$ACTIVE_USER" 2>/dev/null || echo 1000); XDG_RUNTIME_DIR="/run/user/$ACTIVE_UID" sudo -u "$ACTIVE_USER" /home/$ACTIVE_USER/.local/bin/apollo-os-tts-notify.sh wake'

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
