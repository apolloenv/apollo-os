# Mako Configuration - Apollo OS macOS Style
# Transparent design with rounded corners

# Schriftart
font=SF Pro Display 11

# Farben - macOS Style (transparent)
background-color=#1e1e1e80
text-color=#ffffff
border-color=#ffffff1a
progress-color=#ffffff40

# Dimensionen
width=380
height=100
margin=12
padding=16,20
border-size=2
border-radius=18

# Position: Rechts oben
anchor=top-right
layer=overlay
outer-margin=12

# Timeouts
default-timeout=5000
ignore-timeout=0

# Icons
icons=1
max-icon-size=48
icon-location=left

# Nur eine Benachrichtigung gleichzeitig
max-visible=5
group-by=none

# Format
format=<b>%s</b>\n%b

# Urgency Levels
[urgency=low]
background-color=#1e1e1e60
border-color=#ffffff10
text-color=#ffffffaa

[urgency=normal]
background-color=#1e1e1e80
border-color=#ffffff1a
text-color=#ffffff

[urgency=high]
background-color=#ff453a80
border-color=#ff453a40
text-color=#ffffff
border-size=2
default-timeout=0

# Grouped notifications
[grouped]
format=<b>%s</b> (%g)\n%b
