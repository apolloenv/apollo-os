// =============================================================================
// NIRI WM KONFIGURATION - macOS SEQUOIA STYLE
// =============================================================================
// macOS-inspiriertes Design mit typischen Fenstern, Schatten und Animationen
// Dokumentation: https://github.com/YaLTeR/niri/blob/main/resources/default-config.kdl

// -----------------------------------------------------------------------------
// EINGABE (Tastatur, Maus, Touchpad)
// -----------------------------------------------------------------------------
input {
    focus-follows-mouse max-scroll-amount="100%"

    keyboard {
        xkb {
            layout "de"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.15
        accel-profile "adaptive"
        scroll-factor 0.8
    }
}

// -----------------------------------------------------------------------------
// MONITORE (Outputs)
// -----------------------------------------------------------------------------
output "eDP-1" {
    scale 1.25
    position x=0 y=0
}

output "DP-2" {
    scale 1.0
    position x=1536 y=0
}

// -----------------------------------------------------------------------------
// ÜBERSICHT (Overview - Super+O) - Mission Control Style
// -----------------------------------------------------------------------------
overview {
    zoom 0.25
    backdrop-color "#1d1d1f99"
    workspace-shadow {
        off
    }
}

// -----------------------------------------------------------------------------
// HOTKEY OVERLAY
// -----------------------------------------------------------------------------
hotkey-overlay {
    skip-at-startup true
}

// -----------------------------------------------------------------------------
// LAYOUT & DESIGN - macOS Style
// -----------------------------------------------------------------------------
layout {
    gaps 12
    center-focused-column "always"
    default-column-width { proportion 0.66667; }
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.85
        proportion 1.0
    }

    // Fensterrahmen - 2px mit 10% Transparenz
    border {
       width 2
       active-color "rgba(255, 255, 255, 0.1)"
       inactive-color "rgba(255, 255, 255, 0.1)"
    }

    // Schatten - macOS typischer weicher Schatten
    shadow {
        on
        softness 40
        spread 2
        offset x=0 y=8
        color "rgba(0, 0, 0, 0.35)"
        draw-behind-window true
    }

    focus-ring {
        width 0
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

// -----------------------------------------------------------------------------
// FENSTER-REGELN - macOS Window Style
// -----------------------------------------------------------------------------
// Alle Fenster: macOS typischer border-radius (26px)
window-rule {
    geometry-corner-radius 26
    clip-to-geometry true
    draw-border-with-background false
}

// Inaktive Fenster - 50% transparent mit starkem Schatten
window-rule {
    match is-focused=false
    opacity 0.5
    shadow {
        on
        softness 50
        spread 5
        offset x=0 y=12
        color "rgba(0, 0, 0, 0.6)"
        draw-behind-window true
    }
}

// Fokussierte Fenster - volle Opazität mit starkem Schatten
window-rule {
    match is-focused=true
    opacity 1.0
    shadow {
        on
        softness 60
        spread 8
        offset x=0 y=15
        color "rgba(0, 0, 0, 0.7)"
        draw-behind-window true
    }
}

// Vollbild-Apps
window-rule {
    match app-id=r"^(com.microsoft.Edge|code|org.gnome.Loupe|org.gnome.eog|org.gnome.Totem|io.github.celluloid_player.Celluloid|org.remmina.Remmina|remmina)$"
    default-column-width { proportion 1.0; }
}

// Floating Fenster
window-rule {
    match is-floating=true
    default-column-width { proportion 0.6; }
}

// -----------------------------------------------------------------------------
// STARTUP
// -----------------------------------------------------------------------------
spawn-at-startup "xwayland-satellite"
spawn-at-startup "sh" "-c" "waybar -c $HOME/.config/waybar/config-niri"
spawn-at-startup "sh" "-c" "swaybg -i $HOME/System/Wallpaper/current.jpg -m fill"
spawn-at-startup "sh" "-c" "mako --config $HOME/.config/mako/config"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"
spawn-at-startup "sh" "-c" "swayidle -w before-sleep 'hyprlock'"
spawn-at-startup "sh" "-c" "sleep 4 && notify-send 'APOLLO OS' 'Welcome to macOS Mode'"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/apollo-os-welcome-tts.sh"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/apollo-os-power-monitor.sh"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/apollo-os-network-monitor.sh"
spawn-at-startup "sh" "-c" "$HOME/.local/bin/apollo-os-sleep-monitor.sh"

// -----------------------------------------------------------------------------
// LAYER-RULES
// -----------------------------------------------------------------------------
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// -----------------------------------------------------------------------------
// TASTENKÜRZEL (Binds)
// -----------------------------------------------------------------------------
binds {
    // ═══════════════════════════════════════════════════════════════════════
    // APOLLO OS - KEYBOARD SHORTCUTS (macOS Style)
    // ═══════════════════════════════════════════════════════════════════════

    // ─── Help & Launcher ───────────────────────────────────────────────────
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Space { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-rofi-launcher.sh"; }
    Mod+Shift+Space { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-quickmenu.sh"; }
    Mod+Ctrl+Space { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-wallpaper-cycle.sh"; }

    // ─── Window Management ─────────────────────────────────────────────────
    Mod+Q { close-window; }
    Mod+W { toggle-window-floating; }
    Mod+E { consume-or-expel-window-right; }
    Mod+O { toggle-overview; }
    Mod+M { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+C { spawn "sh" "-c" "$HOME/.config/niri/toggle-center.sh"; }
    Mod+J { spawn "sh" "-c" "$HOME/.config/niri/toggle-dock.sh"; }
    Mod+G { spawn "sh" "-c" "$HOME/.config/niri/toggle-gaps.sh"; }
    Mod+R { switch-preset-column-width; }

    // ─── Applications ──────────────────────────────────────────────────────
    Mod+D { spawn "nautilus" "--new-window"; }
    Mod+N { spawn "gnome-text-editor" "--new-window"; }
    Mod+Return { spawn "alacritty"; }
    Mod+K { spawn "kitty"; }
    Mod+B { spawn "firefox" "--new-window"; }
    Mod+T { spawn "ptyxis" "--new-window"; }

    // ─── Navigation (Focus) ────────────────────────────────────────────────
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }

    // ─── Move Windows ──────────────────────────────────────────────────────
    Mod+Alt+Left  { move-column-left; }
    Mod+Alt+Right { move-column-right; }
    Mod+Alt+Up    { move-window-up; }
    Mod+Alt+Down  { move-window-down; }

    // ─── Resize Windows ────────────────────────────────────────────────────
    Mod+Ctrl+Left  { set-column-width "-10%"; }
    Mod+Ctrl+Right { set-column-width "+10%"; }
    Mod+Ctrl+Up    { set-window-height "-10%"; }
    Mod+Ctrl+Down  { set-window-height "+10%"; }

    // ─── System ────────────────────────────────────────────────────────────
    Ctrl+Mod+L { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-lock.sh"; }
    Mod+L { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-lock-hypr.sh"; }
    Mod+Shift+E { quit; }
    Mod+Shift+R { spawn "sh" "-c" "pkill waybar; sleep 0.5; waybar -c $HOME/.config/waybar/config-niri & disown"; }

    // ─── Workspaces ────────────────────────────────────────────────────────
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    // ─── Screenshot ────────────────────────────────────────────────────────
    Mod+S { spawn "sh" "-c" "grim -g \"$(slurp)\" ~/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send 'Screenshot' 'Saved to Screenshots'"; }

    // ─── Voice Input ───────────────────────────────────────────────────────
    Mod+V { spawn "sh" "-c" "$HOME/.local/bin/voice-input"; }

    // ─── Media Keys ────────────────────────────────────────────────────────
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "10%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "10%-"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    // ─── Window Switching ──────────────────────────────────────────────────
    Mod+Tab { focus-window-down-or-column-right; }
    Mod+Shift+Tab { focus-window-up-or-column-left; }

    // ─── Mouse Scroll ──────────────────────────────────────────────────────
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
}

// -----------------------------------------------------------------------------
// ANIMATIONEN - Langsam & Smooth mit leichtem Nachwippen
// -----------------------------------------------------------------------------
animations {
    // Fenster öffnen - mit leichtem Bounce
    window-open {
        spring damping-ratio=0.75 stiffness=220 epsilon=0.0001
    }

    // Fenster schließen - sanfter fade
    window-close {
        duration-ms 350
        curve "ease-out-cubic"
    }

    // Fensterbewegung - mit Nachwippen
    window-movement {
        spring damping-ratio=0.78 stiffness=250 epsilon=0.0001
    }

    // Fenstergröße ändern - leichter Bounce
    window-resize {
        spring damping-ratio=0.82 stiffness=280 epsilon=0.0001
    }

    // Workspace wechseln - mit Nachwippen
    workspace-switch {
        spring damping-ratio=0.72 stiffness=200 epsilon=0.0001
    }

    // Horizontale View-Bewegung - mit Bounce
    horizontal-view-movement {
        spring damping-ratio=0.75 stiffness=230 epsilon=0.0001
    }

    // Overview - Mission Control mit Bounce
    overview-open-close {
        spring damping-ratio=0.7 stiffness=180 epsilon=0.0001
    }

    // Config-Benachrichtigung
    config-notification-open-close {
        duration-ms 400
        curve "ease-out-cubic"
    }

    // Screenshot UI
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-cubic"
    }
}

// -----------------------------------------------------------------------------
// THEME & STYLING
// -----------------------------------------------------------------------------
cursor {
    xcursor-theme "Bibata-Modern-Classic"
}

screenshot-path "~/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

prefer-no-csd

environment {
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gnome"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    GDK_BACKEND "wayland"
    CLUTTER_BACKEND "wayland"
    SDL_VIDEODRIVER "wayland"
    MOZ_ENABLE_WAYLAND "1"
    GTK_THEME "adw-gtk3-dark"
    ADW_DEBUG_COLOR_SCHEME "prefer-dark"
}
