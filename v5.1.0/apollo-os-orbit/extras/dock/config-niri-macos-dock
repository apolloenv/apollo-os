[
    {
        "layer": "top",
        "position": "bottom",
        "height": 48,
        "width": 100,
        "margin-bottom": 2,
        "spacing": 0,
        "exclusive": true,

        "modules-left": [],
        "modules-center": [
            "custom/kitty",
            "custom/terminal",
            "custom/files",
            "custom/fresh",
            "custom/remmina",
            "custom/edge",
            "custom/vscode",
            "custom/neovim",
            "custom/onlyoffice",
            "custom/google"
        ],
        "modules-right": [],

        "custom/files": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Dateien",
            "on-click": "nautilus --new-window"
        },

        "custom/kitty": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Kitty Terminal",
            "on-click": "kitty"
        },

        "custom/terminal": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Alacritty Terminal",
            "on-click": "alacritty"
        },

        "custom/remmina": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Remmina Remote Desktop",
            "on-click": "remmina"
        },

        "custom/edge": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Microsoft Edge",
            "on-click": "microsoft-edge"
        },

        "custom/vscode": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Visual Studio Code",
            "on-click": "code"
        },

        "custom/neovim": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Neovim",
            "on-click": "kitty -e nvim"
        },

        "custom/onlyoffice": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "OnlyOffice",
            "on-click": "flatpak run org.onlyoffice.desktopeditors"
        },

        "custom/fresh": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Fresh Text Editor",
            "on-click": "kitty -e fresh"
        },

        "custom/google": {
            "format": " ",
            "tooltip": true,
            "tooltip-format": "Google Suche",
            "on-click": "microsoft-edge --app=https://www.google.com"
        }
    }
]
