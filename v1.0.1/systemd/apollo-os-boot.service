[Unit]
Description=Apollo OS Boot Splash
DefaultDependencies=no
Before=display-manager.service
After=systemd-vconsole-setup.service

[Service]
Type=oneshot
# HINWEIS: %h funktioniert nicht in System-Services!
# Das Logo wird vom apollo-os-boot-splash-installer.sh nach /usr/share/apollo-os/ kopiert.
ExecStart=/usr/bin/bash -c 'clear && cat /usr/share/apollo-os/boot-logo.txt 2>/dev/null && sleep 2'
StandardOutput=journal+console
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
