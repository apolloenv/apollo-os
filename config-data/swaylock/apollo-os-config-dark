# Apollo OS - Swaylock Configuration (Dark System)
# High Contrast with Blur Effect

# Display
ignore-empty-password
show-failed-attempts
show-keyboard-layout

# Image & Effects
image=$HOME/System/Wallpaper/current.jpg
scaling=fill

# Blur Effect
effect-blur=7x5
effect-vignette=0.5:0.5

# Colors - Light theme for dark system (Inversion Rule)
color=F5F5F5

# Text Colors
text-color=1a1a1a
text-clear-color=1a1a1a
text-caps-lock-color=E84A3F
text-ver-color=4A90E2
text-wrong-color=E84A3F

# Inside Ring Colors
inside-color=F5F5F5CC
inside-clear-color=F5F5F5CC
inside-caps-lock-color=FFEBEECC
inside-ver-color=E3F2FDCC
inside-wrong-color=FFEBEECC

# Ring Colors
ring-color=CCCCCC
ring-clear-color=4CAF50
ring-caps-lock-color=FFA726
ring-ver-color=4A90E2
ring-wrong-color=E84A3F

# Line Colors
line-color=F5F5F5
line-clear-color=F5F5F5
line-caps-lock-color=F5F5F5
line-ver-color=F5F5F5
line-wrong-color=F5F5F5

# Separator Color
separator-color=CCCCCC

# Key Highlight Colors
key-hl-color=4A90E2
bs-hl-color=E84A3F

# Layout
indicator
indicator-radius=100
indicator-thickness=10

# Font
font=Noto Sans
font-size=14

# Positioning
indicator-x-position=960
indicator-y-position=540
