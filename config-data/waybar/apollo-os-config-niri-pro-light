{
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,

    "height": 28, /* Etwas höher für modernen Look */
    "spacing": 0,
    
    "modules-left": ["niri/workspaces"],
    "modules-center": [],
    "modules-right": ["group/drawer", "bluetooth", "network", "pulseaudio", "backlight", "battery", "clock"],

    /* Module Konfiguration */

    "niri/workspaces": {
        "format": "{index}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    "group/drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/synology",
            "custom/btop",
            "tray"
        ]
    },

    "custom/synology": {
        "format": "", 
        "tooltip": true,
        "tooltip-format": "Weitere Systembenachrichtigungen",
        "on-click": "flatpak run com.synology.SynologyDrive"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "clock": {
        "format": "{:%H:%M:%S   APOLLO OS}",
        "format-alt": "{:%H:%M:%S   |   %d. %b %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 1
    },
    
    "battery": {
        "format": "{icon}   {capacity}%",
        "format-discharging": "{icon}   {capacity}%",
        "format-charging": "󰂄   {capacity}%",
        "format-plugged": "   {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{power}W",
        "states": { "warning": 30, "critical": 10 }
    },
    
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "interval": 5
    },
    
    "bluetooth": {
        "format": "",
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "on-click": "blueman-manager"
    },
    
    "pulseaudio": {
        "format": "{icon}   {volume}%",
        "format-muted": " Muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol"
    },
    
    "backlight": {
        "format": "{icon}   {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },
    
    "custom/btop": {
        "format": "󰍛",
        "tooltip": "System Monitor",
        "on-click": "gnome-terminal -e btop"
    }
}
