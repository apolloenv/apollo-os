// =============================================================================
// NIRI WM KONFIGURATION - MODERN DARK STYLE
// =============================================================================
// Diese Datei steuert das Verhalten, Aussehen und die Steuerung von niri.
// Dokumentation: https://github.com/YaLTeR/niri/blob/main/resources/default-config.kdl

// -----------------------------------------------------------------------------
// EINGABE (Tastatur, Maus, Touchpad)
// -----------------------------------------------------------------------------
input {
    // Fokus folgt der Mausbewegung
    focus-follows-mouse max-scroll-amount="100%"
    
    keyboard {
        xkb {
            layout "de" // Deutsches Tastaturlayout
        }
    }
    
    touchpad {
        tap             // Tippen zum Klicken
        dwt             // Deaktiviere Touchpad beim Tippen (Disable While Typing)
        natural-scroll  // Natürliches Scrollen (Inhalt folgt Fingern)
        accel-speed 0.1
        accel-profile "adaptive"
        scroll-factor 1.0
    }
}

// -----------------------------------------------------------------------------
// MONITORE (Outputs)
// -----------------------------------------------------------------------------
output "eDP-1" {
    scale 1.25
    position x=0 y=0
}

output "DP-2" {
    scale 1.0
    position x=1536 y=0
}

// -----------------------------------------------------------------------------
// ÜBERSICHT (Overview - Super+O)
// -----------------------------------------------------------------------------
overview {
    zoom 0.5               // Zoomfaktor der Übersicht (kleiner = mehr Workspaces sichtbar)
    backdrop-color "#00000088" // Hintergrundfarbe der Übersicht (Halbtransparent Schwarz)
    workspace-shadow {
        off                 // Schatten um Workspaces in der Übersicht deaktiviert
    }
}

// -----------------------------------------------------------------------------
// LAYOUT & DESIGN
// -----------------------------------------------------------------------------
layout {
    gaps 13               // Abstand zwischen Fenstern und Bildschirmrand
    center-focused-column "always" // Fokussierte Spalte immer zentrieren (wird per Super+C getoggelt)
    default-column-width { proportion 0.5; } // Standardbreite neuer Fenster (2/3)
    background-color "transparent"
    
    // Vordefinierte Breiten, durch die man mit Super+R zyklisch wechseln kann
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.85
    }

    // Fensterrahmen Design
    border {
       width 3
       // Verlauf von Weiß zu transparentem Weiß (Schwarz-Weiß Design)
       active-gradient from="rgba(255, 255, 255, 1.0)" to="rgba(255, 255, 255, 1.0)" angle=-45 relative-to="workspace-view"
       inactive-color "rgba(80, 80, 80, 0.8)"
    }
    
    shadow {
        on // Fensterschatten aktiviert
    }

    focus-ring {
        width 0 // Fokus-Ring deaktiviert (wir nutzen Border)
    }

    struts {
        // Reservierter Platz für Panels/Bars (hier 0, da Waybar selbst Platz reserviert)
        left 0
        right 0
        top 0
        bottom 0
    }
}

// -----------------------------------------------------------------------------
// FENSTER-REGELN (Window Rules)
// -----------------------------------------------------------------------------
window-rule {
    geometry-corner-radius 12 // Abgerundete Ecken für alle Fenster
    clip-to-geometry true
    draw-border-with-background false
}

// Inaktive Fenster leicht transparent machen
window-rule {
    match is-focused=false
    opacity 0.97
}

// Fokussierte Fenster voll deckend
window-rule {
    match is-focused=true
    opacity 0.99
}

// Spezielle Regeln für bestimmte Apps (immer volle Breite starten)
window-rule {
    match app-id=r"^(com.microsoft.Edge|code|org.gnome.Loupe|org.gnome.eog|org.gnome.Totem|io.github.celluloid_player.Celluloid|org.remmina.Remmina|remmina)$"
    default-column-width { proportion 1.0; }
}

// -----------------------------------------------------------------------------
// STARTUP (Programme die beim Start ausgeführt werden)
// -----------------------------------------------------------------------------
// HINWEIS: Die meisten Services (waybar, swaybg, swayidle, mako, swayosd)
// werden vom apollo-os-wrapper-niri.sh gestartet, um korrekte Environment-
// Variablen und Profile-spezifische Konfigurationen zu verwenden.
// Nur essentielle, nicht-konfigurierbare Services werden hier gestartet.
spawn-at-startup "xwayland-satellite" // XWayland Unterstuetzung
spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1" // Passwort-Dialoge

// -----------------------------------------------------------------------------
// LAYER-RULES (Waybar, Wallpaper, etc.)
// -----------------------------------------------------------------------------
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true // Wallpaper auch in der Übersicht anzeigen
}

// -----------------------------------------------------------------------------
// TASTENKÜRZEL (Binds)
// -----------------------------------------------------------------------------
binds {
    // Hilfe & Rofi
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Space { spawn "sh" "-c" "rofi -show drun -theme $ROFI_THEME_FILE"; }
    Mod+Shift+Space { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-quickmenu.sh"; }
    Mod+Ctrl+Space { spawn "sh" "-c" "$HOME/.local/bin/apollo-os-wallpaper-cycle.sh"; }

    // Fenster Management
    Mod+Q { close-window; }
    Mod+W { toggle-window-floating; }
    Mod+E { consume-or-expel-window-right; } // Fenster in Spalte einfuegen/auswerfen
    Mod+O { toggle-overview; }
    Mod+M { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+C { center-column; } // Spalte zentrieren (niri-interner Befehl)
    Mod+R { switch-preset-column-width; } // Zwischen Breiten wechseln

    // Apps (Immer in neuem Fenster)
    Mod+D { spawn "nautilus" "--new-window"; }
    Mod+N { spawn "gnome-text-editor" "--new-window"; }
    Mod+Return { spawn "alacritty"; }
    Mod+B { spawn "firefox" "--new-window"; }
    Mod+T { spawn "ptyxis" "--new-window"; } // Terminal im Home-Verzeichnis

    // Navigation (Fokus)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }
    
    // Verschieben
    Mod+Alt+Left  { move-column-left; }
    Mod+Alt+Right { move-column-right; }
    Mod+Alt+Up    { move-window-up; }
    Mod+Alt+Down  { move-window-down; }
    
    // Größe ändern
    Mod+Ctrl+Left  { set-column-width "-10%"; }
    Mod+Ctrl+Right { set-column-width "+10%"; }
    Mod+Ctrl+Up    { set-window-height "-10%"; }
    Mod+Ctrl+Down  { set-window-height "+10%"; }

    // System
    Mod+L { spawn "sh" "-c" "swaylock -f -C $SWAYLOCK_CONFIG"; } // Bildschirm sperren
    Mod+Shift+E { quit; }
    Mod+Shift+R { spawn "sh" "-c" "pkill waybar; sleep 0.5; waybar -c $WAYBAR_CONFIG_FILE -s $WAYBAR_STYLE_FILE &"; } // Waybar neu laden
    
    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    
    // Screenshot
    Mod+S { spawn "sh" "-c" "grim -g \"$(slurp)\" $HOME/Bilder/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send 'Screenshot' 'Gespeichert unter Bilder/Screenshots'"; }
    
    // Multimedia Tasten
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "10%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "10%-"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    
    Mod+Tab { focus-window-down-or-column-right; }
    Mod+Shift+Tab { focus-window-up-or-column-left; }
}

// -----------------------------------------------------------------------------
// ANIMATIONEN (Animations)
// -----------------------------------------------------------------------------
// Niri nutzt zwei Arten von Animationen:
// 1. "Curve" (Kurvenbasiert): Dauer in ms + eine Beschleunigungskurve.
// 2. "Spring" (Federbasiert): Physikalische Simulation mit Dämpfung und Steifigkeit.
//
// Möglichkeiten für Kurven: "ease-out-expo", "ease-out-quad", "linear", etc.
// Möglichkeiten für Spring: damping-ratio (Dämpfung, 1.0 = kein Nachschwingen),
//                            stiffness (Steifigkeit, höher = schneller/härter).
// -----------------------------------------------------------------------------
//animations {
//    // Wenn ein neues Fenster erscheint
//    window-open {
//        duration-ms 100
//        curve "ease-out-expo"
//    }
//
//    // Wenn ein Fenster geschlossen wird
//    window-close {
//        duration-ms 100
//        curve "ease-out-quad"
//    }
//
//    // Bewegung von Fenstern innerhalb von Spalten oder zwischen Spalten
//    window-movement {
//        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
//    }
//
//    // Wechsel zwischen Workspaces (Super+Zahlen)
//    workspace-switch {
//        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
//    }
//}

// -----------------------------------------------------------------------------
// SONSTIGES
// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// THEME & STYLING (Icons & Cursor)
// -----------------------------------------------------------------------------
// Neue ICONS und CURSOR-Themes können in folgenden Verzeichnissen abgelegt werden:
// Benutzerbezogen: ~/.local/share/icons
// Systemweit:      /usr/share/icons
//
// Nach dem Kopieren neuer Themes einfach den Namen unten bei 'xcursor-theme' 
// oder in den GNOME-Einstellungen (gsettings) für Icons eintragen.
// -----------------------------------------------------------------------------

cursor {
    // Name des Cursor-Themes (z.B. "Adwaita", "Bibata-Modern-Classic")
    xcursor-theme "WhiteSur-cursors"
    xcursor-size 24
}

// Hinweis: Das Icon-Theme für Apps wird über GSettings oder die GTK-Settings gesteuert.
// Befehl zum Ändern: gsettings set org.gnome.desktop.interface icon-theme 'Dein-Theme-Name'

screenshot-path "$HOME/Bilder/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Verhindere Client-Side-Decorations (CSD) wo möglich (saubererer Look)
prefer-no-csd

environment {
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gnome"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    GDK_BACKEND "wayland"
    CLUTTER_BACKEND "wayland"
    SDL_VIDEODRIVER "wayland"
    MOZ_ENABLE_WAYLAND "1"
}
