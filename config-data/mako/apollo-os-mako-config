# Mako Configuration - Top Overlay
font=Cantarell 12
background-color=#000000
text-color=#ffffff
width=400
height=150
margin=10
padding=15
border-size=2
border-color=#ffffff
border-radius=12

# GANZ OBEN
anchor=top-center
layer=overlay

default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=48
icon-location=left
group-by=app-name

[urgency=low]
border-color=#808080

[urgency=normal]
border-color=#ffffff

[urgency=high]
border-color=#ffffff
border-size=4
default-timeout=0
