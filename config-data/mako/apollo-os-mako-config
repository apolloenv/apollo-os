# Apollo OS - Mako Configuration (Dark System -> Light UI)
# High Contrast Inversion Rule Applied
#
# When system theme is DARK, notifications are LIGHT

# Positioning
anchor=top-right
margin=10
layer=overlay

# Size
width=350
height=150
max-visible=3

# Style
font=Noto Sans 11
background-color=#F5F5F5
text-color=#1a1a1a
border-size=2
border-color=#CCCCCC
border-radius=8

# Progress bar
progress-color=over #4A90E2

# Icons
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Adwaita

# Interaction
default-timeout=5000
ignore-timeout=0

# Grouping
group-by=app-name

# Urgency levels
[urgency=low]
border-color=#4CAF50
background-color=#E8F5E9
text-color=#1B5E20

[urgency=normal]
border-color=#2196F3
background-color=#E3F2FD
text-color=#0D47A1

[urgency=critical]
border-color=#F44336
background-color=#FFEBEE
text-color=#B71C1C
default-timeout=0

# App-specific overrides
[app-name="Apollo OS"]
border-color=#6BA3E8
background-color=#E3F2FD
text-color=#0D47A1
