# Apollo OS - Mako Configuration (Light System -> Dark UI)
# High Contrast Inversion Rule Applied
#
# When system theme is LIGHT, notifications are DARK

# Positioning
anchor=top-right
margin=10
layer=overlay

# Size
width=350
height=150
max-visible=3

# Style
font=Noto Sans 11
background-color=#1a1a1a
text-color=#F5F5F5
border-size=2
border-color=#3a3a3a
border-radius=8

# Progress bar
progress-color=over #4A90E2

# Icons
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Adwaita

# Interaction
default-timeout=5000
ignore-timeout=0

# Grouping
group-by=app-name

# Urgency levels
[urgency=low]
border-color=#66BB6A
background-color=#1B5E20
text-color=#C8E6C9

[urgency=normal]
border-color=#42A5F5
background-color=#0D47A1
text-color=#BBDEFB

[urgency=critical]
border-color=#EF5350
background-color=#B71C1C
text-color=#FFCDD2
default-timeout=0

# App-specific overrides
[app-name="Apollo OS"]
border-color=#6BA3E8
background-color=#0D47A1
text-color=#E3F2FD
